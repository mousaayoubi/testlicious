<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">

                <resource id="Testlicious_AiSeoOptimizer::main"
                          title="AI SEO Optimizer"
                          sortOrder="90">
                    <resource id="Testlicious_AiSeoOptimizer::dashboard"
                              title="Dashboard"
                              sortOrder="10"/>
                    <resource id="Testlicious_AiSeoOptimizer::audit"
                              title="SEO Audit"
                              sortOrder="20"/>
                    <resource id="Testlicious_AiSeoOptimizer::suggestions"
                              title="AI Suggestions"
                              sortOrder="30"/>
                </resource>

                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Testlicious_AiSeoOptimizer::config"
                                      title="AI SEO Optimizer Configuration"
                                      sortOrder="40"/>
                        </resource>
                    </resource>
                </resource>

            </resource>
        </resources>
    </acl>
</config>
