<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="aiseo" translate="label" sortOrder="600">
            <label>AI SEO</label>
        </tab>

        <section id="aiseo_optimizer"
                 translate="label"
                 sortOrder="10"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>AI SEO Optimizer</label>
            <tab>aiseo</tab>
            <resource>Testlicious_AiSeoOptimizer::config</resource>

            <group id="general"
                   translate="label"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>General Settings</label>

                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable AI SEO Optimizer</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="model"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>OpenAI Model</label>
                    <comment>Example: gpt-5-nano</comment>
                </field>

                <field id="max_batch_size"
                       translate="label comment"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Max Products Per Batch</label>
                    <comment>Recommended: 10-50 depending on API rate limits.</comment>
                </field>

                <field id="auto_apply"
                       translate="label comment"
                       type="select"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Auto Apply AI Suggestions</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Recommended: No. Admin should review suggestions first.</comment>
                </field>
            </group>

            <group id="openai"
                   translate="label"
                   sortOrder="20"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="0">
                <label>OpenAI Settings</label>

                <field id="api_key"
                       translate="label comment"
                       type="obscure"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>OpenAI API Key</label>
                    <comment>Enter your OpenAI API key. It will be stored encrypted.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
