<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="aiseo" translate="label" sortOrder="600">
            <label>AI SEO</label>
        </tab>

        <section id="aiseo_optimizer"
                 translate="label"
                 sortOrder="10"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>AI SEO Optimizer</label>
            <tab>aiseo</tab>
            <resource>Testlicious_AiSeoOptimizer::config</resource>

            <group id="general"
                   translate="label"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>General Settings</label>

                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable AI SEO Optimizer</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="model"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>OpenAI Model</label>
                    <comment>Example: gpt-5-nano</comment>
                </field>

                <field id="default_language"
                       translate="label"
                       type="select"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Default Language</label>
                    <source_model>Testlicious\AiSeoOptimizer\Model\Config\Source\Language</source_model>
                </field>

                <field id="default_tone"
                       translate="label"
                       type="select"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Default Tone</label>
                    <source_model>Testlicious\AiSeoOptimizer\Model\Config\Source\Tone</source_model>
                </field>

                <field id="max_batch_size"
                       translate="label comment"
                       type="text"
                       sortOrder="50"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Max Products Per Batch</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <comment>Recommended: 10-50 depending on API rate limits.</comment>
                </field>

                <field id="auto_apply"
                       translate="label comment"
                       type="select"
                       sortOrder="60"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Auto Apply AI Suggestions</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Recommended: No. Admin should review suggestions first.</comment>
                </field>
            </group>

            <group id="openai"
                   translate="label"
                   sortOrder="20"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="0">
                <label>OpenAI Settings</label>

                <field id="api_key"
                       translate="label comment"
                       type="obscure"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>OpenAI API Key</label>
                    <comment>Enter your OpenAI API key. It will be stored encrypted.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>

            <group id="cron"
                   translate="label"
                   sortOrder="30"
                   showInDefault="1"
                   showInWebsite="0"
                   showInStore="0">
                <label>Scheduled Product Scan</label>

                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Enable Scheduled Scan</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable automatic product SEO scans through Magento cron.</comment>
                </field>

                <field id="schedule"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Cron Schedule</label>
                    <validate>required-entry</validate>
                    <comment>
                        Cron expression used to schedule the scan. Example: 0 2 * * * runs every day at 2:00 AM.
                    </comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="store_id"
                       translate="label comment"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Store ID</label>
                    <validate>required-entry validate-digits validate-zero-or-greater</validate>
                    <comment>Magento store view ID used when scanning products.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="product_limit"
                       translate="label comment"
                       type="text"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Product Limit</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <comment>Maximum number of products scanned during each scheduled run.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
