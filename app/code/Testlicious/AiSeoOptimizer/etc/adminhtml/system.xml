<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
<system>
	<section id="aiseo_optimizer"
		translate="label"
		type="text"
		sortOrder="900"
		showInDefault="1"
		showInWebsite="1"
		showInStore="1">
	<label>AI SEO Optimizer</label>
	<tab>services</tab>
	<resource>Testlicious_AiSeoOptimizer::config</resource>
	<group id="general"
		translate="label"
		type="text"
		sortOrder="10"
		showInDefault="1"
		showInWebsite="1"
		showInStore="1">
	<label>General Settings</label>
	<field id="enabled"
		translate="label"
		type="select"
		sortOrder="10"
		shwoInDefault="1"
		showInWebsite="1"
		showInStore="1">
	<label>Enable AI SEO Optimizer</label>
	<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
</field>
<field id="model"
	translate="label"
	type="text"
	sortOrder="20"
	showInDefault="1"
	showInWebsite="1"
	showInStore="1">
<label>Open AI Model</label>
<comment>Example: gpt-5-nano</comment>
</field>
<field id="default_language"
	translate="label"
	type="select"
	sortOrder="30"
	showInDefault="1"
	showInWebsite="1"
	showInStore="1">
<label>Default Language</label>
<source_model>Testlicious\AiSeoOptimizer\Model\Config\Source\Language</source_model>
</field>
<field id="default_tone"
	translate="label"
	type="select"
	sortOrder="40"
	showInDefault="1"
	showInWebsite="1"
	showInStore="1">
<label>Default Tone</label>
<source_model>Testlicious\AiSeoOptimizer\Model\Config\Source\Tone</source_model>
</field>
<field id="max_batch_size"
	translate="label"
	type="text"
	sortOrder="50"
	showInDefault="1"
	showInWebsite="1"
	showInStore="1">
<label>Max Products Per Batch</label>
<comment>Recommeneded: 10-50 depending on API rate limits.</comment>
</field>
<field id="auto_apply"
	translate="label"
	type="select"
	sortOrder="60"
	shwoInDefault="1"
	showInWesbite="1"
	showInStore="1">
<label>Auto Apply AI Suggestions</label>
<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
<comment>Recommended: No. Admin should review suggestions first.</comment>
</field>
</group>
<group id="openai"
	translate="label"
	type="text"
	sortOrder="20"
	showInDefault="1"
	showInWebsite="1"
	showInStore="0">
<label>OpenAI Settings</label>
<field id="api_key"
	translate="label"
	type="obscure"
	sortOrder="1-"
	showInDefault="1"
	showInWebsite="1"
	showInStore="0">
<label>OpenAI API Key</label>
<backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
</field>
</group>
</section>
</system>
</config>
