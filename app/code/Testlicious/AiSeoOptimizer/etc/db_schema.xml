<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="testlicious_aiseo_audit" resource="default" engine="innodb" comment="Testlicious AI SEO Audit">
        <column xsi:type="int" name="audit_id" unsigned="true" nullable="false" identity="true" comment="Audit ID"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="Entity Type"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Entity ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="entity_name" nullable="true" length="255" comment="Entity Name"/>
        <column xsi:type="varchar" name="current_meta_title" nullable="true" length="255" comment="Current Meta Title"/>
        <column xsi:type="text" name="current_meta_description" nullable="true" comment="Current Meta Description"/>
        <column xsi:type="varchar" name="current_url_key" nullable="true" length="255" comment="Current URL Key"/>
        <column xsi:type="smallint" name="seo_score" unsigned="true" nullable="false" default="0" comment="SEO Score"/>
        <column xsi:type="text" name="issues_json" nullable="true" comment="Issues JSON"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="Status"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="audit_id"/>
        </constraint>

        <index referenceId="TESTLICIOUS_AISEO_AUDIT_ENTITY" indexType="btree">
            <column name="entity_type"/>
            <column name="entity_id"/>
            <column name="store_id"/>
        </index>

        <index referenceId="TESTLICIOUS_AISEO_AUDIT_SCORE" indexType="btree">
            <column name="seo_score"/>
        </index>
    </table>

    <table name="testlicious_aiseo_suggestion" resource="default" engine="innodb" comment="Testlicious AI SEO Suggestions">
        <column xsi:type="int" name="suggestion_id" unsigned="true" nullable="false" identity="true" comment="Suggestion ID"/>
        <column xsi:type="int" name="audit_id" unsigned="true" nullable="false" comment="Audit ID"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="Entity Type"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Entity ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="suggested_meta_title" nullable="true" length="255" comment="Suggested Meta Title"/>
        <column xsi:type="text" name="suggested_meta_description" nullable="true" comment="Suggested Meta Description"/>
        <column xsi:type="text" name="suggested_short_description" nullable="true" comment="Suggested Short Description"/>
        <column xsi:type="text" name="suggested_description" nullable="true" comment="Suggested Description"/>
        <column xsi:type="text" name="suggested_keywords_json" nullable="true" comment="Suggested Keywords JSON"/>
        <column xsi:type="text" name="suggested_faq_json" nullable="true" comment="Suggested FAQ JSON"/>
        <column xsi:type="text" name="seo_notes" nullable="true" comment="SEO Notes"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending_review" comment="Status"/>
        <column xsi:type="varchar" name="model" nullable="true" length="64" comment="OpenAI Model"/>
        <column xsi:type="int" name="prompt_tokens" unsigned="true" nullable="true" comment="Prompt Tokens"/>
        <column xsi:type="int" name="completion_tokens" unsigned="true" nullable="true" comment="Completion Tokens"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="suggestion_id"/>
        </constraint>

        <constraint xsi:type="foreign"
                    referenceId="TESTLICIOUS_AISEO_SUGGESTION_AUDIT_ID"
                    table="testlicious_aiseo_suggestion"
                    column="audit_id"
                    referenceTable="testlicious_aiseo_audit"
                    referenceColumn="audit_id"
                    onDelete="CASCADE"/>

        <index referenceId="TESTLICIOUS_AISEO_SUGGESTION_AUDIT" indexType="btree">
            <column name="audit_id"/>
        </index>

        <index referenceId="TESTLICIOUS_AISEO_SUGGESTION_ENTITY" indexType="btree">
            <column name="entity_type"/>
            <column name="entity_id"/>
            <column name="store_id"/>
        </index>
    </table>

    <table name="testlicious_aiseo_generation_log" resource="default" engine="innodb" comment="Testlicious AI SEO Generation Log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="Entity Type"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Entity ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="action" nullable="false" length="64" comment="Action"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" comment="Status"/>
        <column xsi:type="varchar" name="model" nullable="true" length="64" comment="OpenAI Model"/>
        <column xsi:type="text" name="message" nullable="true" comment="Message"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Error Message"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>

        <index referenceId="TESTLICIOUS_AISEO_GENERATION_LOG_ENTITY" indexType="btree">
            <column name="entity_type"/>
            <column name="entity_id"/>
            <column name="store_id"/>
        </index>

        <index referenceId="TESTLICIOUS_AISEO_GENERATION_LOG_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
